# Optional server-only AI extraction.
# Never prefix with NEXT_PUBLIC_ and never commit real API keys.
FOLIO_AI_PROVIDER=
FOLIO_AI_API_KEY=
FOLIO_AI_MODEL=gemini-3.8-flash
